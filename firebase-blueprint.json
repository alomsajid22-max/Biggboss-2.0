        "tieBreakerPolicy": { "type": "string", "enum": ["ADMIN_DECIDES", "CAPTAIN_DECIDES", "RANDOM_DRAW", "NO_EVICTION"] },
        "cancelledReason": { "type": "string" },
        "createdBy": { "type": "string" },
