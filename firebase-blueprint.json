{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Private authenticated player account, unique Player ID, ban/eviction history flags, and server-verified role.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID owning this account." },
        "email": { "type": "string", "description": "Private Google account email (owner/admin only)." },
        "username": { "type": "string", "description": "Unique lowercase login username (optional for legacy Google accounts)." },
        "displayName": { "type": "string", "description": "Unique public housemate display name (3-24 chars)." },
        "normalizedName": { "type": "string", "description": "Lowercase alphanumeric slug used for uniqueness reservation." },
        "playerId": { "type": "string", "description": "Unique persistent Player ID (e.g., GH-XXXX)." },
        "characterId": { "type": "string", "description": "Selected 3D housemate model ID (Player 01 .. Player 15)." },
        "role": { "type": "string", "enum": ["PLAYER", "ADMIN"], "description": "Authorization role; defaults to PLAYER on registration and is immutable from non-admin clients." },
        "seasonId": { "type": "string", "description": "Currently active multiplayer season ID." },
        "banned": { "type": "boolean", "description": "True when an authorized ADMIN has banned this account." },
        "banReason": { "type": "string", "description": "Optional moderation note recorded when banned." },
        "evictedSeasons": { "type": "integer", "description": "Historical count of seasons from which this player was evicted." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp set via FieldValue.serverTimestamp()." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp set via FieldValue.serverTimestamp()." }
      },
      "required": ["userId", "displayName", "normalizedName", "playerId", "characterId", "role", "seasonId", "createdAt", "updatedAt"]
    },
    "AdminGrant": {
      "title": "AdminGrant",
      "description": "Server-managed administrator grant document. Client writes are strictly forbidden.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the trusted administrator." },
        "role": { "type": "string", "enum": ["ADMIN"], "description": "Must equal ADMIN." },
        "grantedBy": { "type": "string", "description": "Trusted backend issuer." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "role", "createdAt"]
    },
    "DisplayNameClaim": {
      "title": "DisplayNameClaim",
      "description": "Atomic uniqueness lock preventing duplicate display names across accounts.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID." },
        "displayName": { "type": "string", "description": "Original cased display name." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "createdAt"]
    },
    "SeasonSession": {
      "title": "SeasonSession",
      "description": "Shared Bigg Boss reality-show season metadata, captaincy state, and 15-player capacity counter.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Season display title." },
        "status": { "type": "string", "enum": ["LOBBY", "LIVE", "ENDED"], "description": "Season lifecycle status controlled by ADMIN." },
        "maxPlayers": { "type": "integer", "description": "Maximum allowed concurrent housemates (15)." },
        "activeCount": { "type": "integer", "description": "Current number of active player slots (0..15)." },
        "dayNightMode": { "type": "string", "enum": ["day", "evening", "night"], "description": "Current house lighting cycle." },
        "captainUid": { "type": "string", "description": "UID of the reigning House Captain." },
        "captainPlayerId": { "type": "string", "description": "Persistent Player ID of the reigning House Captain." },
        "captainDisplayName": { "type": "string", "description": "Display name of the reigning House Captain." },
        "captainTitle": { "type": "string", "description": "Title / week label for the current captaincy." },
        "activeTaskId": { "type": "string", "description": "Currently active daily/captaincy task ID." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "status", "maxPlayers", "activeCount", "dayNightMode", "createdAt", "updatedAt"]
    },
    "SeasonMember": {
      "title": "SeasonMember",
      "description": "Public lobby & house roster entry for an authenticated human player (max 15 active per season).",
      "type": "object",
      "properties": {
        "seasonId": { "type": "string", "description": "Parent season ID." },
        "userId": { "type": "string", "description": "Firebase Auth UID of the player." },
        "playerId": { "type": "string", "description": "Unique persistent Player ID." },
        "displayName": { "type": "string", "description": "Public unique player display name." },
        "characterId": { "type": "string", "description": "Selected 3D housemate skin ID (Player 01 .. Player 15)." },
        "slotNumber": { "type": "integer", "description": "Assigned slot index in season (1..15)." },
        "role": { "type": "string", "enum": ["PLAYER", "ADMIN"], "description": "Verified role in season." },
        "status": { "type": "string", "enum": ["LOBBY", "IN_HOUSE", "OFFLINE", "REMOVED", "EVICTED", "BANNED"], "description": "Participation and presence state." },
        "online": { "type": "boolean", "description": "True when active in lobby or 3D house." },
        "sessionId": { "type": "string", "description": "Active client session token preventing duplicate concurrent sessions." },
        "joinedAt": { "type": "string", "format": "date-time" },
        "lastSeenAt": { "type": "string", "format": "date-time" }
      },
      "required": ["seasonId", "userId", "playerId", "displayName", "characterId", "slotNumber", "role", "status", "online", "sessionId", "joinedAt", "lastSeenAt"]
    },
