rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isAdmin() {
      return request.auth != null &&
             (request.auth.token.get('admin', false) == true || request.auth.token.get('role', '') == 'ADMIN');
    }

    match /seasons/{seasonId}/cctvRecordings/{fileName} {
      allow read: if isAdmin();
      allow write: if isAdmin() &&
                      fileName.matches('^[a-zA-Z0-9_\\-]+\\.(webm|mp4)$') &&
                      request.resource != null &&
                      request.resource.size <= 15 * 1024 * 1024 &&
                      request.resource.contentType.matches('^video/(webm|mp4).*');
      allow delete: if isAdmin();
    }
  }
}
